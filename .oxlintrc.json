{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "promise"],
	"categories": { "correctness": "error", "suspicious": "error", "perf": "warn" },
	"rules": {
		"typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
		"typescript/no-explicit-any": "error",
		"typescript/no-non-null-assertion": "error",
		// Decoded plist values carry their payload in these keys.
		"no-underscore-dangle": ["error", { "allow": ["__data", "__len", "__text", "__date", "__int", "__uid"] }],
		"no-console": "off",
		"no-await-in-loop": "off",
		"promise/no-nesting": "off"
	},
	"ignorePatterns": ["worker-configuration.d.ts", "node_modules"]
}
