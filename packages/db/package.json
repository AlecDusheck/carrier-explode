{
	"name": "@carrier-explode/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"test": "vitest run",
		"check": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
		"generate": "drizzle-kit generate",
		"migrate": "wrangler d1 migrations apply carrier-explode-index --remote",
		"migrate:local": "wrangler d1 migrations apply carrier-explode-index --local"
	},
	"dependencies": {
		"@carrier-explode/schema": "workspace:*",
		"@carrier-explode/values": "workspace:*",
		"drizzle-orm": "1.0.0-rc.4",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@carrier-explode/tsconfig": "workspace:*",
		"@cloudflare/workers-types": "^5.20261003.1",
		"@types/node": "^22.20.3",
		"drizzle-kit": "1.0.0-rc.4",
		"typescript": "^6.0.0",
		"vitest": "^5.0.3",
		"wrangler": "^4.147.0"
	}
}
