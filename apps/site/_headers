# Drawings and logos change rarely and keep their names: browsers keep them a week instead of revalidating each view.
/carriers/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/phones/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/android/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/ios/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/files/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
# Kept out of search indexes, like every page the worker answers.
/*
  X-Robots-Tag: noindex
