{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "carrier-explode-site",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": ["nodejs_compat"],
	// @sveltejs/adapter-cloudflare reads the build's directory from here, not from an environment.
	"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
	"observability": { "enabled": true },
	"env": {
		"dev": {
			"name": "carrier-explode-site-dev",
			"workers_dev": true,
			"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
			"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "carrier-explode-ingest-dev" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "carrier-explode-index-dev",
					"database_id": "ae71cafc-0b64-4b70-9dce-a4c0c6eaa12f",
				},
			],
			"cache": { "enabled": true },
			"vars": {
				"CACHE_TTL": {
					"pinned": 2592000,
					"latest": 86400,
					"missing": 60,
					"raw": 2592000,
					"rawBrowser": 86400,
					"staleWhileRevalidate": 86400,
					"derived": 2592000,
				},
				"LEGACY_REPAIR": true,
				"API_ORIGIN": "https://carrier-explode-api-dev.simplyalec.workers.dev",
			},
			"secrets": { "required": ["PURGE_TOKEN"] },
		},
		"production": {
			"name": "carrier-explode-site",
			"observability": {
				"enabled": true,
				"logs": { "head_sampling_rate": 0.1 },
				"traces": { "enabled": true, "head_sampling_rate": 0.1 },
			},
			// www is a zone Redirect Rule to the apex, so it never reaches this worker.
			"routes": [{ "pattern": "carrierexplode.com", "custom_domain": true }],
			"workers_dev": false,
			"assets": { "binding": "ASSETS", "directory": ".svelte-kit/cloudflare" },
			"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "carrier-explode-ingest" }],
			// Read through one session per request, so reads go to the nearest replica and stay in order within the request.
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "carrier-explode-index",
					"database_id": "02fef939-84a4-4509-9727-deaa7fc8cbf7",
				},
			],
			// Cloudflare checks this worker's own cache before running it, and honours the Cache-Control that
			// src/hooks.server.ts puts on every response. Zone cache settings never apply to what a worker returns.
			"cache": { "enabled": true },
			"vars": {
				// Seconds, by what a response holds (src/lib/server/cache-policy.ts). A publish purges the pages and data it changes.
				"CACHE_TTL": {
					// A pinned version's files never change; its page also lists every version, which a publish's purge refreshes.
					"pinned": 2592000,
					"latest": 86400,
					// Usually a typo or a crawler, and the answer changes when Apple ships: absorbs a hammering, heals quickly.
					"missing": 60,
					// A bundle member never changes under its URL. Browsers keep it a day, so a mistake does not outlive the edge's month.
					"raw": 2592000,
					"rawBrowser": 86400,
					"staleWhileRevalidate": 86400,
					// Derived JSON in the colo cache, keyed by the content it came from (src/lib/server/cache.ts).
					"derived": 2592000,
				},
				// Old URLs that would 404 are 301ed to the page that holds them now (src/lib/server/legacy.ts).
				"LEGACY_REPAIR": true,
				// Where the public API (apps/api) answers, as the wiki and llms.txt link it.
				"API_ORIGIN": "https://api.carrierexplode.com",
			},
			// For /internal/purge; set with `wrangler secret put PURGE_TOKEN --env production`.
			"secrets": { "required": ["PURGE_TOKEN"] },
		},
	},
}
