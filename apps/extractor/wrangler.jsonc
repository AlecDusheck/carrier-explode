{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Two environments, dev and production, each declaring every binding, var and trigger it uses: wrangler does not inherit
	// them. Worker and Workflow names are account-wide, so dev's end in `-dev` (test/tables.test.ts checks).
	"name": "carrier-explode-extractor",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	// global_fetch_strictly_public: a purge reaches the readers, which are Workers on this account (or zone), only
	// through the public front door.
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"observability": { "enabled": true },
	// FUS's auth tables (src/galaxy/auth-param.dat), imported as an ArrayBuffer; the dataset's README and LICENSE, as text.
	"rules": [
		{ "type": "Data", "globs": ["**/*.dat"] },
		{ "type": "Text", "globs": ["**/*.md", "**/*.txt"] },
	],
	// Workers' maximum CPU: an extract step streams a firmware member, and an index message reads a build's profiles.
	// Both count per invocation, which runs many Workflow steps: an Apple OTA unit's file steps make about seven
	// subrequests each, a reindex's normalize steps about 200, so a full reindex makes over 100,000.
	"limits": { "cpu_ms": 300000, "subrequests": 1000000 },
	// No public routes: /run and /runs are bearer-authed on the workers.dev URL.
	"workers_dev": true,
	// Declarative Durable Object classes, instead of `migrations`. Containers need SQLite storage.
	"exports": {
		"Extractor": { "type": "durable-object", "storage": "sqlite" },
	},

	"env": {
		"dev": {
			"name": "carrier-explode-extractor-dev",
			"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "carrier-explode-ingest-dev" }],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "carrier-explode-index-dev",
					"database_id": "ae71cafc-0b64-4b70-9dce-a4c0c6eaa12f",
					"migrations_dir": "../../packages/db/migrations",
					"migrations_pattern": "../../packages/db/migrations/*/migration.sql",
				},
			],
			"containers": [
				{
					"class_name": "Extractor",
					"image": "./container/Dockerfile",
					"image_build_context": "../..",
					"instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 20000 },
					// One past the sum of CONTAINER_SHARE, as in production.
					"max_instances": 3,
				},
			],
			"durable_objects": { "bindings": [{ "name": "EXTRACTOR", "class_name": "Extractor" }] },
			"queues": {
				"producers": [
					{ "binding": "INDEX_QUEUE", "queue": "carrier-explode-index-dev" },
					{ "binding": "PURGE_QUEUE", "queue": "carrier-explode-purge-dev" },
				],
				"consumers": [
					// One message at a time: indexing reads and writes rows other units share. A message is tried 10 times, 5 minutes
					// apart, so a D1 hiccup or a norm/ object a running reindex has yet to write passes; then it waits in the
					// dead-letter queue, its error in the Workers Logs.
					{
						"queue": "carrier-explode-index-dev",
						"max_batch_size": 1,
						"max_concurrency": 1,
						"max_retries": 10,
						"retry_delay": 300,
						"dead_letter_queue": "carrier-explode-index-dlq-dev",
					},
					// A batch (100 messages or 30 s) is one purge per reader, one batch at a time: the readers' cache purges share the
					// account's bucket of 25, refilled 5 a minute. A refused purge retries the batch a minute later; one refused 10
					// times waits in the dead-letter queue.
					{
						"queue": "carrier-explode-purge-dev",
						"max_batch_size": 100,
						"max_batch_timeout": 30,
						"max_concurrency": 1,
						"max_retries": 10,
						"retry_delay": 60,
						"dead_letter_queue": "carrier-explode-purge-dlq-dev",
					},
				],
			},
			"workflows": [
				{ "binding": "IOS_BUILD", "name": "carrier-explode-ios-build-dev", "class_name": "IosBuildWorkflow" },
				{ "binding": "APPLE_OTA", "name": "carrier-explode-apple-ota-dev", "class_name": "AppleOtaWorkflow" },
				{
					"binding": "PIXEL_DEVICE",
					"name": "carrier-explode-pixel-device-dev",
					"class_name": "PixelDeviceWorkflow",
				},
				{ "binding": "PIXEL_OTA", "name": "carrier-explode-pixel-ota-dev", "class_name": "PixelOtaWorkflow" },
				{
					"binding": "GALAXY_BUILD",
					"name": "carrier-explode-galaxy-build-dev",
					"class_name": "GalaxyBuildWorkflow",
				},
				// A reindex of all normalizes every held artifact, a step per 100 settings files or 10 modem configurations:
				// production's backfill is up to about 5,300 steps.
				{
					"binding": "REINDEX",
					"name": "carrier-explode-reindex-dev",
					"class_name": "ReindexWorkflow",
					"limits": { "steps": 25000 },
				},
				{ "binding": "DATASET", "name": "carrier-explode-dataset-dev", "class_name": "DatasetWorkflow" },
				{ "binding": "LABELS", "name": "carrier-explode-labels-dev", "class_name": "LabelsWorkflow" },
				{
					"binding": "CHECK",
					"name": "carrier-explode-check-dev",
					"class_name": "CheckWorkflow",
					"limits": { "steps": 10000 },
				},
			],
			"services": [{ "binding": "API", "service": "carrier-explode-api-dev", "entrypoint": "Api" }],
			// Workers AI and the Web Search API, for the labels Workflow; remote even under wrangler dev.
			"ai": { "binding": "AI" },
			// Checks run only by hand: POST /run, or /__scheduled with --test-scheduled.
			"triggers": { "crons": [] },
			"vars": {
				// A rehearsal of production's order at medium scope: two phones a family, every build since a recent day, and
				// Apple OTA files for its own phones only.
				"SCOPE": {
					"ios": {
						"devices": { "codes": ["iPhone18,1", "iPhone17,1"] },
						"everythingSince": "2026-09-28",
						"backfill": "newest",
						"minMajor": 18,
					},
					"android": {
						"devices": { "codes": ["frankel", "komodo"] },
						"everythingSince": "2026-08-01",
						"backfill": "newest",
					},
					"samsung": {
						"families": ["Galaxy S"],
						"exclude": [" FE", " Ultra", "+"],
						"salesCodes": ["EUX", "ZTO"],
						"releasedSince": "2026-01",
						"majors": 1,
						"builds": 2,
					},
					"appleOta": {
						"ios": { "majors": 1, "phones": ["iPhone18,1", "iPhone17,1"] },
						"ipados": "none",
						"watchos": "none",
					},
				},
				"CONTAINER_SHARE": { "ios-build": 1, "galaxy-build": 1 },
				"PURGE_ORIGINS": [
					"https://carrier-explode-site-dev.simplyalec.workers.dev",
					"https://carrier-explode-api-dev.simplyalec.workers.dev",
				],
				"LABELLER": {
					"gateway": "default",
					"provider": "exa",
					"model": "@cf/deepseek-ai/deepseek-v4-pro-0813",
					"perKind": 10,
				},
				// Production's, but for the settle delay: a rehearsal derives minutes after its last unit.
				"PIPELINE_CRONS": {},
				"SETTLE_DELAY_S": 300,
				"STEP_RETRIES": { "step": 3, "container": 2, "delayMs": 10000 },
				"STEP_TIMEOUT_MS": 1800000,
				"CONTAINER_LIMITS": { "readyMs": 120000, "jobDeadlineMs": 3480000 },
				"FEED_CONCURRENCY": {
					"iosMerge": 8,
					"ipswBundles": 8,
					"appleCatalogs": 4,
					"galaxyReads": 6,
					"pixelOta": 6,
				},
				"INDEX_BATCH": { "otaFiles": 50, "derivedSources": 25, "changedReleases": 25, "profileRows": 25 },
			},
			"secrets": { "required": ["RUN_TOKEN", "PURGE_TOKEN"] },
		},

		"production": {
			"name": "carrier-explode-extractor",
			"observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 1 } },
			"r2_buckets": [{ "binding": "BUCKET", "bucket_name": "carrier-explode-ingest" }],
			// packages/db's index; its migrations are packages/db's, applied by hand.
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "carrier-explode-index",
					"database_id": "02fef939-84a4-4509-9727-deaa7fc8cbf7",
				},
			],
			// The two jobs a Worker step cannot do, an IPSW's root filesystem and a Galaxy AP member, on the smallest custom
			// type (1 vCPU, 3 GiB) with the disk the AP's `system` partition needs (the 20 GB maximum).
			"containers": [
				{
					"class_name": "Extractor",
					"image": "./container/Dockerfile",
					"image_build_context": "../..",
					"instance_type": { "vcpu": 1, "memory_mib": 3072, "disk_mb": 20000 },
					// One past the sum of CONTAINER_SHARE (each iOS or Galaxy build holds one container at a time): a destroyed
					// container's slot can be released minutes after it answers, while its build's next step already asks for one.
					"max_instances": 7,
				},
			],
			"durable_objects": { "bindings": [{ "name": "EXTRACTOR", "class_name": "Extractor" }] },
			"queues": {
				"producers": [
					{ "binding": "INDEX_QUEUE", "queue": "carrier-explode-index" },
					{ "binding": "PURGE_QUEUE", "queue": "carrier-explode-purge" },
				],
				"consumers": [
					// One message at a time: indexing reads and writes rows other units share. A message is tried 10 times, 5 minutes
					// apart, so a D1 hiccup or a norm/ object a running reindex has yet to write passes; then it waits in the
					// dead-letter queue, its error in the Workers Logs.
					{
						"queue": "carrier-explode-index",
						"max_batch_size": 1,
						"max_concurrency": 1,
						"max_retries": 10,
						"retry_delay": 300,
						"dead_letter_queue": "carrier-explode-index-dlq",
					},
					// A batch (100 messages or 30 s) is one purge per reader, one batch at a time: the readers' cache purges share the
					// account's bucket of 25, refilled 5 a minute. A refused purge retries the batch a minute later; one refused 10
					// times waits in the dead-letter queue.
					{
						"queue": "carrier-explode-purge",
						"max_batch_size": 100,
						"max_batch_timeout": 30,
						"max_concurrency": 1,
						"max_retries": 10,
						"retry_delay": 60,
						"dead_letter_queue": "carrier-explode-purge-dlq",
					},
				],
			},
			// One Workflow per pipeline (src/pipelines.ts), an instance per unit.
			"workflows": [
				{ "binding": "IOS_BUILD", "name": "carrier-explode-ios-build", "class_name": "IosBuildWorkflow" },
				{ "binding": "APPLE_OTA", "name": "carrier-explode-apple-ota", "class_name": "AppleOtaWorkflow" },
				{
					"binding": "PIXEL_DEVICE",
					"name": "carrier-explode-pixel-device",
					"class_name": "PixelDeviceWorkflow",
				},
				{ "binding": "PIXEL_OTA", "name": "carrier-explode-pixel-ota", "class_name": "PixelOtaWorkflow" },
				{
					"binding": "GALAXY_BUILD",
					"name": "carrier-explode-galaxy-build",
					"class_name": "GalaxyBuildWorkflow",
				},
				{ "binding": "LABELS", "name": "carrier-explode-labels", "class_name": "LabelsWorkflow" },
				// A feed's check: Galaxy's asks version.xml about ten models a step and FUS about ten firmware a step.
				{
					"binding": "CHECK",
					"name": "carrier-explode-check",
					"class_name": "CheckWorkflow",
					"limits": { "steps": 10000 },
				},
				// A reindex of all normalizes every held artifact, a step per 100 settings files or 10 modem configurations:
				// production's backfill is up to about 5,300 steps.
				{
					"binding": "REINDEX",
					"name": "carrier-explode-reindex",
					"class_name": "ReindexWorkflow",
					"limits": { "steps": 25000 },
				},
				{ "binding": "DATASET", "name": "carrier-explode-dataset", "class_name": "DatasetWorkflow" },
			],
			"services": [{ "binding": "API", "service": "carrier-explode-api", "entrypoint": "Api" }],
			// Workers AI and the Web Search API, for the labels Workflow.
			"ai": { "binding": "AI" },
			// PIPELINE_CRONS' (test/tables.test.ts checks).
			"triggers": {
				"crons": [
					"*/20 * * * *",
					"10,30,50 * * * *",
					"5 * * * *",
					"15 * * * *",
					"25 * * * *",
					"50 3 * * *",
					"30 4 * * SUN",
				],
			},
			"vars": {
				// What ingest scans (src/scope.ts): the newest `majors` OS majors, each on each family's newest generation
				// that has a build on it. Changing the families needs a cost estimate and approval.
				"SCOPE": {
					// Phones by the feeds' release days. everythingSince is the cutover: every build from then on; before it, iOS takes
					// each release and the newest major's betas, a Pixel its newest build of each train.
					"ios": {
						"devices": { "releasedSince": "2023-09" },
						"everythingSince": "2026-10-05",
						"backfill": "releases",
						"minMajor": 18,
					},
					"android": {
						"devices": { "releasedSince": "2020-10" },
						"everythingSince": "2026-10-05",
						"backfill": "quarterly",
					},
					// Every regional model Google Play lists, by name. Each sales code reaches a multi-CSC package no code before it does
					// on some model.
					"samsung": {
						"families": ["Galaxy S", "Galaxy Z Fold", "Galaxy Z Flip", "Galaxy A5", "Galaxy A3"],
						"exclude": [" FE"],
						"salesCodes": [
							"EUX",
							"ZTO",
							"PEO",
							"INS",
							"XSG",
							"XXV",
							"SKZ",
							"KOO",
							"TGY",
							"CHC",
							"XAC",
							"XAA",
							"ATT",
						],
						"releasedSince": "2025-01",
						"majors": 3,
						"builds": "all",
					},
					// iPadOS and watchOS come only from here: each source's file for the newest OS it is listed for.
					"appleOta": { "ios": "all", "ipados": "current", "watchos": "current" },
				},
				"CONTAINER_SHARE": { "ios-build": 3, "galaxy-build": 3 },
				// The readers' origins, each purged at PURGE_PATH with the PURGE_TOKEN secret both readers hold.
				"PURGE_ORIGINS": ["https://carrierexplode.com", "https://api.carrierexplode.com"],
				"LABELLER": {
					"gateway": "default",
					"provider": "exa",
					"model": "@cf/deepseek-ai/deepseek-v4-pro-0813",
					"perKind": 200,
				},
				// triggers.crons, by feed (test/tables.test.ts checks). A check tops a container pipeline up to its CONTAINER_SHARE,
				// so the container builds are checked often; Pixel and Apple's OTAs hold no container and ship a few times a month,
				// so hourly. Each feed has its own minutes. Labels weekly, after Sunday's dataset: names change slowly, and each costs
				// a search and a model call.
				"PIPELINE_CRONS": {
					"ios-build": "*/20 * * * *",
					"galaxy-build": "10,30,50 * * * *",
					"pixel-device": "5 * * * *",
					"pixel-ota": "15 * * * *",
					"apple-ota": "25 * * * *",
					"dataset": "50 3 * * *",
					"labels": "30 4 * * SUN",
				},
				// A backfill's iOS builds end at most a build (about 40 minutes) apart while the 20-minute check keeps containers
				// busy, so a backfill derives once, at its end.
				"SETTLE_DELAY_S": 3600,
				"STEP_RETRIES": { "step": 3, "container": 2, "delayMs": 10000 },
				"STEP_TIMEOUT_MS": 1800000,
				// A cold start pulls an image of a few hundred MB. A job's deadline (58 minutes) is about twice the slowest whole
				// IPSW, so a hung job's container is gone within the hour.
				"CONTAINER_LIMITS": { "readyMs": 120000, "jobDeadlineMs": 3480000 },
				// The community catalogs (ipsw.me, AppleDB) a few requests at a time; a Worker keeps six connections open.
				"FEED_CONCURRENCY": {
					"iosMerge": 8,
					"ipswBundles": 8,
					"appleCatalogs": 4,
					"galaxyReads": 6,
					"pixelOta": 6,
				},
				// Each bounded by an invocation's 1,000 D1 queries: an OTA file costs about eleven, a derived source up to nineteen,
				// a release's changes about ten.
				"INDEX_BATCH": { "otaFiles": 50, "derivedSources": 25, "changedReleases": 25, "profileRows": 25 },
			},
			// RUN_TOKEN: bearer for /run and /runs. PURGE_TOKEN: the readers' purge bearer.
			"secrets": { "required": ["RUN_TOKEN", "PURGE_TOKEN"] },
		},
	},
}
